generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// --- ENUMS ---

enum Rol {
  CLIENTE_INTERNO
  TECNICO
  COORDINADOR_MTTO
  JEFE_MTTO
  SUPER_ADMIN
}

enum Estatus {
  ACTIVO
  INACTIVO
}

enum Prioridad {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

enum EstadoTarea {
  PENDIENTE
  ASIGNADA
  EN_PROGRESO
  EN_PAUSA
  RECHAZADO
  RESUELTO
  CERRADO
  CANCELADA
}

enum TipoEvento {
  CREACION
  CAMBIO_ESTADO
  ASIGNACION
}

enum TipoTarea {
  TICKET
  PLANEADA
  EXTRAORDINARIA
}

enum ClasificacionTarea {
  PREVENTIVO
  CORRECTIVO
  AUTONOMO
}

enum TipoNotificacion {
  NUEVO_REPORTE
  TAREA_ASIGNADA
  TAREA_INICIADA
  TAREA_PAUSADA
  TAREA_RESUELTA
  TAREA_CERRADA
  TAREA_RECHAZADA
  TAREA_CANCELADA
  TAREA_MODIFICADA
  TAREA_REASIGNADA
  REVISION_PENDIENTE
  EQUIPO_RECHAZO
}

enum EstadoIdempotencia {
  PROCESSING
  COMPLETED
  FAILED
}

// --- ENUMS BI MAQUINARIA (FASE 1) ---

// Impacto de producción confirmado explícitamente por el técnico al resolver.
// NO_CONFIRMADO → dato provisional; no alimenta métricas confirmadas.
// SIN_PARO      → falla real pero sin detención de línea; no genera IntervaloParoMaquina.
// PARO_PARCIAL  → detención parcial; genera IntervaloParoMaquina con porcentaje opcional 1-99.
// PARO_TOTAL    → detención total; genera IntervaloParoMaquina con porcentaje = 100.
enum ImpactoProduccionConfirmado {
  NO_CONFIRMADO
  SIN_PARO
  PARO_PARCIAL
  PARO_TOTAL
}

// Ciclo de vida de una FallaMaquina.
// PENDIENTE_DE_DIAGNOSTICO → creada provisionalmente (aún sin confirmación técnica).
// ABIERTA                  → falla confirmada por el técnico; en atención.
// REHABILITADA             → técnico confirmó máquina funcional (RESUELTO en Tarea).
// CERRADA                  → cierre administrativo posterior.
// DESCARTADA               → técnico determinó que no hubo falla real.
enum EstadoFalla {
  PENDIENTE_DE_DIAGNOSTICO
  ABIERTA
  REHABILITADA
  CERRADA
  DESCARTADA
}

// Clasifica si el intervalo de paro fue planeado (preventivo) o no.
enum TipoParo {
  PLANIFICADO
  NO_PLANIFICADO
}

// Calidad del dato para consumo BI.
// PROVISIONAL        → dato aún sin confirmación técnica.
// CONFIRMADO         → datos explícitamente confirmados por el técnico.
// HISTORICO_ESTIMADO → datos anteriores a la Fase 1, derivados de campos legacy.
// DATO_INCOMPLETO    → PARO_PARCIAL registrado sin porcentaje de afectación.
enum CalidadDato {
  PROVISIONAL
  CONFIRMADO
  HISTORICO_ESTIMADO
  DATO_INCOMPLETO
}

// --- MODELOS ---

model Departamento {
  id     Int    @id @default(autoincrement())
  nombre String @unique

  planta String
  tipo   String

  estado   Estatus   @default(ACTIVO)
  usuarios Usuario[]
  tareas   Tarea[]
  maquinas Maquina[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Usuario {
  id       Int     @id @default(autoincrement())
  username String  @unique
  email    String? @unique
  password String
  nombre   String
  telefono String?
  cargo    String?
  imagen   String?

  rol    Rol     @default(CLIENTE_INTERNO)
  estado Estatus @default(ACTIVO)

  mustChangePassword Boolean @default(false)

  departamentoId Int?
  // Restricción explícita: si se borra el depto, el usuario queda sin depto (null)
  departamento   Departamento? @relation(fields: [departamentoId], references: [id], onDelete: SetNull)

  tareasCreadas   Tarea[] @relation("Creador")
  tareasAsignadas Tarea[] @relation("Responsables")

  historialEventos HistorialTarea[]
  bitacoras        Bitacora[]

  intervalosTiempo          IntervaloTiempo[]
  refreshTokens             RefreshToken[]
  resetTokens               PasswordResetToken[]
  pushSubscriptions         PushSubscription[]
  notificacionesLog         NotificacionLog[]
  notificaciones            Notificacion[]
  reglasResponsable         ReglaRecurrencia[]       @relation("TecnicoResponsable")
  ajustesRecurrenciaCreados ReglaRecurrenciaAjuste[] @relation("AjusteRecurrenciaCreador")
  reglasActividadCreadas            ReglaActividadRecurrente[]       @relation("ReglaActividadCreador")
  reglasActividadResponsable        ReglaActividadRecurrente[]       @relation("ReglaActividadResponsables")
  ajustesActividadRecurrenteCreados ReglaActividadRecurrenteAjuste[] @relation("ReglaActividadAjusteCreador")
  idempotencyRecords        IdempotencyRecord[]
  // BI Maquinaria — técnico que confirmó fallas o paros
  fallasConfirmadas         FallaMaquina[]           @relation("FallaConfirmadaPor")
  parosConfirmados          IntervaloParoMaquina[]   @relation("ParoConfirmadoPor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tarea {
  id Int @id @default(autoincrement())

  // --- CLASIFICACIÓN DEL TRABAJO ---
  tipo          TipoTarea           @default(TICKET)
  clasificacion ClasificacionTarea?

  titulo      String    @db.VarChar(255)
  categoria   String?
  descripcion String    @db.Text
  prioridad   Prioridad @default(MEDIA)

  // --- UBICACIÓN ---
  planta String?
  area   String?

  // --- ESTADO Y FLUJO ---
  estado EstadoTarea @default(PENDIENTE)

  fechaVencimiento         DateTime?
  fechaVencimientoOriginal DateTime?
  tiempoEstimado           Int?

  // --- PLANIFICACIÓN E INVENTARIO ---
  horaInicioProgramada DateTime?
  horaFinProgramada    DateTime?
  refacciones          Json?

  fechaInicio  DateTime?
  finalizadoAt DateTime?

  duracionReal Int? @default(0)

  // --- INDUSTRIAL/MAQUINARIA ---
  maquinaId         Int?
  maquina           Maquina? @relation(fields: [maquinaId], references: [id], onDelete: SetNull)
  paroProduccion    Boolean  @default(false)
  impactoProduccion Int?

  // --- RELACIONES ---
  creadorId Int
  creador   Usuario @relation("Creador", fields: [creadorId], references: [id], onDelete: Restrict)

  departamentoId Int?
  departamento   Departamento? @relation(fields: [departamentoId], references: [id], onDelete: SetNull)

  responsables Usuario[] @relation("Responsables")

  historial      HistorialTarea[]
  imagenes       Imagen[]
  intervalos     IntervaloTiempo[]
  notificaciones Notificacion[]
  fallaMaquina   FallaMaquina?          // Relación 1-1 opcional: una tarea puede generar una falla confirmada
  intervalosParo IntervaloParoMaquina[] // Relación 1-N: paros físicos vinculados a esta tarea

  incidenteId         String?   @db.VarChar(80)
  fechaParoProduccion DateTime?

  // --- RECURRENCIA (nullable — solo tickets generados por ReglaRecurrencia) ---
  // fechaCicloLogica: fecha ancla pura del ciclo (no ajustada por fines de semana/feriados)
  // fechaVencimiento: fecha física/ajustada de ejecución real (ya existe arriba)
  reglaRecurrenciaId        Int?
  fechaCicloLogica          DateTime?
  fechaProgramadaPreventiva DateTime?
  reglaRecurrencia          ReglaRecurrencia? @relation(fields: [reglaRecurrenciaId], references: [id], onDelete: SetNull)

  // Recurrencia de actividades: conserva el origen histórico de la tarea.
  reglaActividadRecurrenteId Int?
  reglaActividadRecurrente   ReglaActividadRecurrente? @relation("ReglaActividadTareas", fields: [reglaActividadRecurrenteId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Anti-duplicados de ciclos: un ticket por regla + fecha lógica de ciclo
  @@unique([reglaRecurrenciaId, fechaCicloLogica])
  @@unique([reglaActividadRecurrenteId, fechaCicloLogica])
  // --- ÍNDICES DE RENDIMIENTO ---
  @@index([creadorId])
  @@index([departamentoId])
  @@index([estado])
  @@index([createdAt])
  @@index([titulo])
  @@index([tipo])
  @@index([departamentoId, estado])
  @@index([creadorId, createdAt])
  @@index([maquinaId])
  @@index([maquinaId, estado])
  @@index([maquinaId, tipo, createdAt])
  @@index([tipo, estado, createdAt])
  @@index([clasificacion, createdAt])
  @@index([fechaVencimiento, estado, createdAt])
  @@index([reglaRecurrenciaId, fechaCicloLogica])
  @@index([incidenteId])
  @@index([fechaParoProduccion])
}

model Maquina {
  id Int @id @default(autoincrement())

  codigo      String  @unique @db.VarChar(50) // Formato MBC0000 (ERP Magnus)
  nombre      String  @db.VarChar(255) // Nombre descriptivo (ERP Magnus)
  proceso     String  @db.VarChar(150) // Proceso/Tipo (ERP Magnus)
  descripcion String? @db.Text // Observaciones (ERP Magnus)
  imagen      String? @db.VarChar(255)

  criticidad String? @default("C") @db.VarChar(10) // Clasificación ABC (Editable localmente)
  estado     String  @default("OPERATIVA") @db.VarChar(50) // Estado operativo (Operativa, En Reparación, Inactiva, Baja)

  marca       String? @db.VarChar(100) // Fabricante (ERP Magnus)
  modelo      String? @db.VarChar(100) // Modelo (ERP Magnus)
  numeroSerie String? @unique @db.VarChar(100) // S/N (ERP Magnus)

  planta           String?  @db.VarChar(100) // Planta/Piso derivada (ERP Magnus)
  area             String? @db.VarChar(100) // Área/Línea derivada (ERP Magnus)
  ubicacionDetalle String? @db.VarChar(255) // Ubicación cruda (ERP Magnus)

  fechaInstalacion    DateTime? // Instalación (ERP Magnus)
  fechaUltimoServicio DateTime? // Último Servicio (Calculado localmente)

  departamentoId Int? // Departamento derivado (ERP Magnus)
  departamento   Departamento? @relation(fields: [departamentoId], references: [id], onDelete: SetNull)

  tareas             Tarea[]
  reglasRecurrencia  ReglaRecurrencia[]       // Reglas de mantenimiento preventivo recurrente
  plantillasRevision PlantillaRevisionMaquina[]
  fallas             FallaMaquina[]            // Historial de fallas confirmadas del equipo
  intervalosParo     IntervaloParoMaquina[]    // Historial de paros físicos del equipo

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([codigo])
  @@index([estado])
  @@index([planta, area])
  @@index([proceso])
  @@index([criticidad])
  @@index([departamentoId])
}

model HistorialTarea {
  id Int @id @default(autoincrement())

  tareaId Int
  tarea   Tarea @relation(fields: [tareaId], references: [id], onDelete: Cascade)

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  tipo           TipoEvento
  estadoAnterior EstadoTarea?
  estadoNuevo    EstadoTarea?

  nota String? @db.Text

  imagenes Imagen[]

  createdAt DateTime @default(now())
}

model Imagen {
  id   Int     @id @default(autoincrement())
  url  String
  tipo String?

  tareaId Int
  tarea   Tarea @relation(fields: [tareaId], references: [id], onDelete: Cascade)

  historialId Int?
  historial   HistorialTarea? @relation(fields: [historialId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

model Bitacora {
  id       Int     @id @default(autoincrement())
  accion   String
  detalles String? @db.Text

  usuarioId Int?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

model IdempotencyRecord {
  id             Int                @id @default(autoincrement())
  key            String             @db.VarChar(120)
  usuarioId      Int
  usuario        Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  method         String             @db.VarChar(12)
  operation      String             @db.VarChar(120)
  route          String             @db.VarChar(255)
  payloadHash    String             @db.VarChar(64)
  status         EstadoIdempotencia @default(PROCESSING)
  responseStatus Int?
  responseBody   Json?
  errorMessage   String?            @db.Text
  expiresAt      DateTime
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([usuarioId, operation, key])
  @@index([usuarioId, operation])
  @@index([expiresAt])
  @@index([status])
}

model Notificacion {
  id        Int              @id @default(autoincrement())
  usuarioId Int
  usuario   Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tipo      TipoNotificacion
  titulo    String           @db.VarChar(255)
  cuerpo    String           @db.Text

  // Relación
  tareaId Int?
  tarea   Tarea? @relation(fields: [tareaId], references: [id], onDelete: SetNull)

  leida     Boolean  @default(false)
  accionada Boolean  @default(false)
  createdAt DateTime @default(now())

  // Índices optimizados
  @@index([usuarioId])
  @@index([usuarioId, leida])
  @@index([tareaId])
  @@index([createdAt])
}

model IntervaloTiempo {
  id Int @id @default(autoincrement())

  tareaId Int
  tarea   Tarea @relation(fields: [tareaId], references: [id], onDelete: Cascade)

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  estado EstadoTarea

  inicio DateTime  @default(now())
  fin    DateTime?

  duracion Int?
}

model RefreshToken {
  id          String @id @default(uuid())
  hashedToken String

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  revoked   Boolean   @default(false)
  revokedAt DateTime?
  expiresAt DateTime?
  lastUsedAt DateTime?
  userAgent String?   @db.VarChar(500)
  ip        String?   @db.VarChar(64)
  createdAt DateTime  @default(now())

  @@index([usuarioId, revoked, expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PushSubscription {
  id       Int    @id @default(autoincrement())
  endpoint String @unique @db.VarChar(500)
  p256dh   String @db.Text
  auth     String @db.Text

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  lastSuccess  DateTime?
  failureCount Int       @default(0)

  @@index([usuarioId])
}

model NotificacionLog {
  id String @id @default(uuid())

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  titulo String
  cuerpo String @db.Text

  dispositivosObjetivo Int
  enviadosExito        Int
  fallidos             Int

  createdAt DateTime @default(now())

  @@index([usuarioId])
  @@index([createdAt])
}

// --- RECURRENCIA DE MANTENIMIENTOS PREVENTIVOS ---

enum FrecuenciaRecurrencia {
  SEMANAL // Cada 7 días
  QUINCENAL // Cada 14 días
  MENSUAL // Mismo día del mes siguiente (con ajuste de desbordamiento)
  TRIMESTRAL // Cada 3 meses calendar preservando ancla
  PERSONALIZADA_DIAS // Cada N días definidos en intervaloDias
}

enum TipoAjusteRecurrencia {
  MOVER
  OMITIR
}

enum UnidadRecurrenciaActividad {
  DIA
  SEMANA
  MES
}

model ReglaRecurrencia {
  id Int @id @default(autoincrement())

  // --- MÁQUINA OBJETIVO ---
  maquinaId Int
  maquina   Maquina @relation(fields: [maquinaId], references: [id], onDelete: Cascade)

  // --- DATOS DE LA TAREA QUE SE GENERA ---
  titulo         String    @db.VarChar(255) // Título que tendrá cada ticket generado
  descripcion    String?   @db.Text
  categoria      String    @default("MAQUINARIA") @db.VarChar(100)
  prioridad      Prioridad @default(MEDIA)
  tiempoEstimado Int? // Minutos estimados (opcional)

  // --- FRECUENCIA ---
  frecuencia    FrecuenciaRecurrencia
  intervaloDias Int? // Obligatorio solo si frecuencia = PERSONALIZADA_DIAS

  // --- TÉCNICO RESPONSABLE ---
  tecnicoResponsableId Int
  tecnicoResponsable   Usuario @relation("TecnicoResponsable", fields: [tecnicoResponsableId], references: [id], onDelete: Restrict)

  // --- CONTROL DE CICLOS ---
  // proximaFechaEjecucion: fecha LÓGICA pura del próximo ciclo (sin ajuste de fin de semana/feriado)
  // El cron busca reglas donde proximaFechaEjecucion <= hoy
  proximaFechaEjecucion DateTime
  fechaInicio           DateTime @default(now())

  activo Boolean @default(true) // Permite pausar la regla sin borrarla

  // --- RELACIÓN CON TICKETS GENERADOS ---
  tareas  Tarea[] // Todos los tickets creados por esta regla
  ajustes ReglaRecurrenciaAjuste[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([maquinaId])
  @@index([tecnicoResponsableId])
  @@index([proximaFechaEjecucion, activo]) // Cron query: reglas activas vencidas hoy
}

model ReglaRecurrenciaAjuste {
  id Int @id @default(autoincrement())

  reglaRecurrenciaId Int
  reglaRecurrencia   ReglaRecurrencia @relation(fields: [reglaRecurrenciaId], references: [id], onDelete: Cascade)

  fechaOriginal DateTime
  periodoAnio   Int
  periodoMes    Int

  tipo       TipoAjusteRecurrencia
  fechaNueva DateTime?
  motivo     String?               @db.Text
  activo     Boolean               @default(true)

  createdById Int
  createdBy   Usuario @relation("AjusteRecurrenciaCreador", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([reglaRecurrenciaId, fechaOriginal])
  @@index([reglaRecurrenciaId, periodoAnio, periodoMes])
  @@index([tipo, activo])
  @@index([createdById])
}

model ReglaActividadRecurrente {
  id Int @id @default(autoincrement())

  titulo      String    @db.VarChar(255)
  descripcion String?   @db.Text
  categoria   String
  planta      String?
  area        String
  prioridad   Prioridad @default(MEDIA)

  fechaInicio DateTime
  fechaFin    DateTime?

  horaInicioMinutos Int?
  horaFinMinutos    Int?
  tiempoEstimado    Int?

  unidad    UnidadRecurrenciaActividad
  intervalo Int                        @default(1)

  proximaFechaEjecucion DateTime

  activo      Boolean   @default(true)
  archivadoAt DateTime?

  creadorId Int
  creador   Usuario @relation("ReglaActividadCreador", fields: [creadorId], references: [id], onDelete: Restrict)

  responsables Usuario[]                        @relation("ReglaActividadResponsables")
  tareas       Tarea[]                          @relation("ReglaActividadTareas")
  ajustes      ReglaActividadRecurrenteAjuste[] @relation("ReglaActividadAjustes")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([archivadoAt, activo, proximaFechaEjecucion])
  @@index([planta, area])
  @@index([categoria])
  @@index([creadorId])
}

model ReglaActividadRecurrenteAjuste {
  id Int @id @default(autoincrement())

  reglaActividadRecurrenteId Int
  reglaActividadRecurrente   ReglaActividadRecurrente @relation("ReglaActividadAjustes", fields: [reglaActividadRecurrenteId], references: [id], onDelete: Restrict)

  fechaOriginal DateTime
  tipo          TipoAjusteRecurrencia
  fechaNueva    DateTime?
  motivo        String?               @db.Text
  activo        Boolean               @default(true)

  createdById Int
  createdBy   Usuario @relation("ReglaActividadAjusteCreador", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([reglaActividadRecurrenteId, fechaOriginal])
  @@index([reglaActividadRecurrenteId, activo, fechaOriginal])
  @@index([createdById])
}

model ConfiguracionSistema {
  id          String   @id @default(uuid())
  clave       String   @unique @db.VarChar(100)
  valor       String   @db.Text
  descripcion String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PlantillaRevision {
  id          Int              @id @default(autoincrement())
  nombre      String           @db.VarChar(255)
  descripcion String?          @db.Text
  aplicaA     TipoUsoPlantilla @default(AUTONOMO)
  contenido   Json // Estructura JSON de secciones y preguntas
  activa      Boolean          @default(true)

  maquinas PlantillaRevisionMaquina[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlantillaRevisionMaquina {
  plantillaId Int
  maquinaId   Int
  orden       Int     @default(0)
  activa      Boolean @default(true)

  plantilla PlantillaRevision @relation(fields: [plantillaId], references: [id], onDelete: Cascade)
  maquina   Maquina           @relation(fields: [maquinaId], references: [id], onDelete: Cascade)

  @@id([plantillaId, maquinaId])
  @@index([maquinaId, activa])
}

enum TipoUsoPlantilla {
  AUTONOMO
  PREVENTIVO
  AMBOS
}

// --- MODELOS BI MAQUINARIA (FASE 1) ---

// FallaMaquina: representa una avería confirmada (o pendiente de confirmación) en un equipo.
// Una Tarea correctiva puede estar vinculada como máximo a una FallaMaquina (relación 1-1).
// Reglas de Negocio:
//   - Nace en PENDIENTE_DE_DIAGNOSTICO con calidad PROVISIONAL.
//   - El técnico la mueve a ABIERTA al confirmar la falla (fechaFallaConfirmada + confirmadoPorId).
//   - Al pasar la tarea a RESUELTO, se graba fechaRestauracion atómicamente y pasa a REHABILITADA.
//   - Si el técnico descarta la falla → DESCARTADA, contabilizaComoFalla = false.
//   - Solo las fallas ABIERTA/REHABILITADA/CERRADA con contabilizaComoFalla=true
//     alimentan las métricas de Frecuencia, MTTR, MTBF y Confiabilidad.
model FallaMaquina {
  id Int @id @default(autoincrement())

  // Equipo afectado — no borrar historia aunque el equipo sea dado de baja
  maquinaId Int
  maquina   Maquina @relation(fields: [maquinaId], references: [id], onDelete: Restrict)

  // Tarea correctiva que originó la falla — opcional para permitir fallas sin tarea asociada
  tareaId Int?    @unique // 1 tarea → máximo 1 falla; sin @unique no habría integridad 1-1
  tarea   Tarea?  @relation(fields: [tareaId], references: [id], onDelete: SetNull)

  // Estado y calidad del registro
  estado              EstadoFalla             @default(PENDIENTE_DE_DIAGNOSTICO)
  calidadDato         CalidadDato             @default(PROVISIONAL)
  contabilizaComoFalla Boolean               @default(true)
  impactoConfirmado   ImpactoProduccionConfirmado @default(NO_CONFIRMADO)

  // Fechas de la falla — reportada viene del cliente; confirmada la graba el técnico
  fechaFallaReportada  DateTime
  fechaFallaConfirmada DateTime?  // Nullable: aún no confirmada en PENDIENTE_DE_DIAGNOSTICO
  fechaRestauracion    DateTime?  // Se graba atómicamente cuando la tarea pasa a RESUELTO

  // Técnico que confirmó — nullable en PENDIENTE_DE_DIAGNOSTICO
  confirmadoPorId Int?
  confirmadoPor   Usuario? @relation("FallaConfirmadaPor", fields: [confirmadoPorId], references: [id], onDelete: Restrict)

  // Snapshots de dimensiones para BI histórico inalterable
  // Se copian en el momento de confirmación para que futuros cambios en Maquina no alteren el historial.
  snapshotCodigo     String  @db.VarChar(50)
  snapshotPlanta     String? @db.VarChar(100)
  snapshotArea       String? @db.VarChar(100)
  snapshotProceso    String  @db.VarChar(150)
  snapshotCriticidad String? @db.VarChar(10)

  intervalosParo IntervaloParoMaquina[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([maquinaId, estado])
  @@index([fechaFallaConfirmada])              // Consultas por periodo de frecuencia
  @@index([maquinaId, fechaFallaConfirmada])   // MTBF: secuencia de fallas por equipo
  @@index([calidadDato, contabilizaComoFalla]) // Filtro rápido de datos BI válidos
}

// IntervaloParoMaquina: intervalo de tiempo en que la máquina estuvo físicamente detenida.
// Es independiente de IntervaloTiempo (que mide el esfuerzo del técnico, no el paro de la máquina).
// Reglas de Negocio:
//   - Solo se crea cuando impactoConfirmado = PARO_PARCIAL o PARO_TOTAL.
//   - SIN_PARO → no se crea ningún registro.
//   - PARO_PARCIAL → porcentajeAfectacion es opcional (null si el técnico no puede estimarlo).
//   - PARO_TOTAL   → porcentajeAfectacion = 100 siempre.
//   - duracionMinutos se calcula de forma atómica en el servicio (Math.round((fin-inicio)/60000)).
//     NO se almacena como columna para evitar desincronización con inicio/fin.
//   - La Disponibilidad usa minutosEquivalentes = duraciónParo × (porcentaje/100).
//     Si porcentaje es null → se muestra por separado con DATO_INCOMPLETO.
model IntervaloParoMaquina {
  id Int @id @default(autoincrement())

  // Equipo que estuvo detenido
  maquinaId Int
  maquina   Maquina @relation(fields: [maquinaId], references: [id], onDelete: Restrict)

  // Falla que generó el paro — opcional para cubrir paros preventivos sin falla
  fallaId Int?
  falla   FallaMaquina? @relation(fields: [fallaId], references: [id], onDelete: SetNull)

  // Tarea asociada al paro — opcional
  tareaId Int?
  tarea   Tarea? @relation(fields: [tareaId], references: [id], onDelete: SetNull)

  // Clasificación del paro
  tipo   TipoParo                    // Obligatorio y explícito — sin default para evitar suposiciones
  impacto ImpactoProduccionConfirmado // Obligatorio y explícito — solo PARO_PARCIAL o PARO_TOTAL

  // Porcentaje de afectación — validado en servicio:
  //   SIN_PARO: no existe fila → no aplica
  //   PARO_PARCIAL: null | entero 1-99
  //   PARO_TOTAL:   100
  porcentajeAfectacion Int?

  // Calidad — afecta si el dato es usable en disponibilidad
  calidadDato CalidadDato @default(CONFIRMADO)

  // Ventana temporal del paro
  inicio DateTime
  fin    DateTime? // Null = paro todavía abierto
  // duracionMinutos NO se persiste; se calcula siempre desde inicio y fin en el servicio.

  // Técnico que confirmó el paro
  confirmadoPorId Int
  confirmadoPor   Usuario @relation("ParoConfirmadoPor", fields: [confirmadoPorId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([maquinaId, inicio])  // Consultas de disponibilidad por equipo y periodo
  @@index([fallaId])            // Navegación desde FallaMaquina
  @@index([tareaId])            // Navegación desde Tarea
  @@index([tipo, calidadDato])  // Filtro por tipo de paro y calidad
}
